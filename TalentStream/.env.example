# ─── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tsuser:tspassword@db:5432/talentstream
RABBITMQ_URL=amqp://tsuser:tspassword@rabbitmq:5672

# ─── Auth Feature Flag ────────────────────────────────────────────────────────
# Set to "true" to enforce Keycloak SSO. Set to "false" for local mock login.
AUTH_ENABLED=false

# ─── Keycloak (only needed when AUTH_ENABLED=true) ────────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=talentstream
KEYCLOAK_CLIENT_ID=talentstream-backend
KEYCLOAK_CLIENT_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_CONTAINER_NAME=resumes

# ─── CORS ──────────────────────────────────────────────────────────────────
# Set to your Oracle/production frontend URL when deploying.
# Multiple origins: ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Internal ─────────────────────────────────────────────────────────────────
FASTAPI_INTERNAL_SECRET=internal-webhook-secret
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ResourceStream-Backend"

JINA_API_KEY=""